@model MayaAstro.Models.HoroscopeVM

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration;
    var uploadUrl = Configuration["ApiSettings:UploadURL"];
}
<style>
    .submit-button {
        background-color: #0f4989 !important;
        color: white !important;
        float: right;
    }

        .submit-button:hover {
            background-color: #c9c6c22b !important;
            color: #0f4989 !important;
        }

    .submit-button-right {
        background-color: #0f4989 !important;
        color: white !important;
    }

        .submit-button-right:hover {
            background-color: #c9c6c22b !important;
            color: #0f4989 !important;
        }

    #entriesPerPage {
        display: block;
        height: 40px;
    }

    .action-buttons.position-absolute.top-0.end-0.p-2 {
        margin-top: -33px;
        margin-right: -28px;
    }
    .card{
        min-height: 350px;
    }

   
        .action-buttons .btn {
            display: flex;
            align-items: center;
            justify-content: center;
        }

    .action-buttons {
        position: relative;
        display: flex;
        justify-content: flex-end;
        /* gap: 0.5rem; */
        right: 0;
        top: 0;
        /* padding: 1rem; */
        border-bottom: 1px solid #c0c7cf;
    }
</style>
<main id="main" class="main">
    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="row" style="display: flex;
  flex-direction: row;
  justify-content: space-between;">

                            <div class="col-lg-6 ">
                                <h5 class="card-title">Horoscope List</h5>
                            </div>
                            <div class="col-lg-6 text-end">
                                <a class="btn submit-button-right mb-3" href="@Url.Action("AddHoroscope", "Admin")">Add Horoscope</a>
                            </div>
                        </div>

                        <div class="row-search-enquiry mt-3" style="display: flex; flex-direction:row;
                justify-content:space-between;">
                           
                            <div class="col-lg-2">
                                <div class="input-group">
                                    <label class="mx-2 mt-2">Entries per page: </label>
                                    <select id="entriesPerPage" class="form-select" onchange="initializePagination()">
                                        <option value="9" selected="">9</option>
                                        <option value="15">15</option>
                                        <option value="30">30</option>
                                        <option value="45">45</option>
                                    </select>

                                </div>
                            </div>



                            <div class="col-lg-3">
                                <div class="input-group mb-3">
                                    <label class="mx-2 mt-2">Search: </label>
                                    <input type="text" class="form-control" id="searchInput" placeholder="Search by Title" onkeyup="filterCards()" />
                                </div>
                            </div>
                        </div>




                        <div class="row  g-4 mt-4" id="horoscopesCards">
                            @if (Model?.HoroscopeList?.Any() == true)
                            {
                                foreach (var horoscopes in Model.HoroscopeList)
                                {
                                    <div class="col-lg-4 col-md-6 mb-4  horoscopes-card" data-name="@horoscopes.Title">
                                        <div class="card">

                                            <div class="action-buttons mb-2">
                                                <a class="btn btn-sm me-1" href="@Url.Action("AddHoroscope", "Admin", new { id = horoscopes.Id })" title="Edit"> <i class="fas fa-edit text-primary"></i>
                                                    <span class="tooltip-text"></span>
                                                </a>
                                                <a class="btn btn-sm" href="@Url.Action("DeleteHoroscope", "Admin", new { id = horoscopes.Id })" title="Delete"
                                                   onclick="return confirm('Are you sure you want to delete this blog?');">
                                                    <i class="fas fa-trash text-danger"></i>
                                                    <span class="tooltip-text"></span>
                                                </a>
                                            </div>
                                            <div class="">
                                           
                                                <img src="@uploadUrl@horoscopes.BannerImageUrl" alt="Image" class="card-img-top mb-lg-3 mb-md-2 mb-sm-2" style="width: 100%; height: 200px; object-fit: cover;" />
                                           

                                            
                                            <h6>@horoscopes.Title</h6>
                                        </div>
                                           
                                    </div>
                                    </div>

                                   
                                }
                            }
                            else
                            {
                                <div class="col-lg-12">
                                    <div class="alert alert-warning" role="alert">
                                        No Blogs available.
                                    </div>
                                </div>
                            }
                        </div>

                      
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center" id="paginationControls"></ul>
                        </nav>

                        <div id="pageIndicator" class="text-center mt-3"></div>

                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<!-- Required Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
 
    <script>
    @functions {
        public string TruncateToWords(string text, int wordCount)
        {
            if (string.IsNullOrWhiteSpace(text)) return string.Empty;

            var words = text.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
            return string.Join(" ", words.Take(wordCount)) + (words.Length > wordCount ? "..." : "");
        }
    }
        let itemsPerPage = 10; // Default number of items per page
    let currentPage = 1; // Current page
    let totalPages = 0; // Total pages
    let filteredCards = null; // To store filtered cards

    // Initialize pagination
    function initializePagination() {
        const horoscopesCards = document.querySelectorAll('.horoscopes-card');
        itemsPerPage = parseInt(document.getElementById("entriesPerPage").value); // Get selected items per page
        totalPages = Math.ceil(horoscopesCards.length / itemsPerPage);
        currentPage = 1; // Reset to the first page
        renderPage(currentPage);
        renderPaginationControls();
        updatePageIndicator();
    }

    // Render a specific page of cards
    function renderPage(page) {
        const horoscopesCards = filteredCards || document.querySelectorAll('.horoscopes-card');
        const start = (page - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        horoscopesCards.forEach((card, index) => {
            card.style.display = (index >= start && index < end) ? "block" : "none"; // Show or hide cards based on page
        });
    }

    // Render pagination controls
    function renderPaginationControls() {
        const paginationControls = document.getElementById("paginationControls");
        paginationControls.innerHTML = ""; // Clear existing controls
        const horoscopesCards = filteredCards || document.querySelectorAll('.horoscopes-card');
        totalPages = Math.ceil(horoscopesCards.length / itemsPerPage);

        // Add "Previous" button
        if (currentPage > 1) {
            const prevLi = document.createElement("li");
            prevLi.className = "page-item";
            prevLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage - 1})">Previous</a>`;
            paginationControls.appendChild(prevLi);
        }

        // Show first pages (1, 2, 3)
        const pageRange = 3;
        for (let i = 1; i <= Math.min(pageRange, totalPages); i++) {
            const li = document.createElement("li");
            li.className = `page-item ${i === currentPage ? 'active' : ''}`;
            li.innerHTML = `<a class="page-link" href="#" onclick="changePage(${i})">${i}</a>`;
            paginationControls.appendChild(li);
        }

        // Add ellipsis if needed
        if (totalPages > pageRange + 1) {
            const ellipsisLi = document.createElement("li");
            ellipsisLi.className = "page-item disabled";
            ellipsisLi.innerHTML = `<span class="page-link">...</span>`;
            paginationControls.appendChild(ellipsisLi);
        }

        // Show last page if needed
        if (totalPages > pageRange) {
            const lastLi = document.createElement("li");
            lastLi.className = "page-item";
            lastLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${totalPages})">${totalPages}</a>`;
            paginationControls.appendChild(lastLi);
        }

        // Add "Next" button
        if (currentPage < totalPages) {
            const nextLi = document.createElement("li");
            nextLi.className = "page-item";
            nextLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage + 1})">Next</a>`;
            paginationControls.appendChild(nextLi);
        }
    }

    // Change the current page
    function changePage(page) {
        currentPage = page;
        renderPage(currentPage);
        renderPaginationControls();
        updatePageIndicator();
    }

    // Update the page indicator
    function updatePageIndicator() {
        const pageIndicator = document.getElementById("pageIndicator");
        pageIndicator.innerHTML = `Page ${currentPage} of ${totalPages}`; // Update the text
    }

    // Filter cards based on search input and category
    function filterCards() {
        const searchInput = document.getElementById("searchInput").value.toLowerCase();
        const cards = document.querySelectorAll(".horoscopes-card");

        filteredCards = Array.from(cards).filter(card => {
            const horoscopesName = card.getAttribute("data-name").toLowerCase();
            const nameMatches = horoscopesName.includes(searchInput);
            

            return horoscopesName.includes(searchInput);
        });

        // Hide all cards first
        cards.forEach(card => card.style.display = "none");

        // Show filtered cards
        filteredCards.forEach((card, index) => {
            card.style.display = (index < itemsPerPage) ? "block" : "none";
        });

        // Update total pages based on filtered cards
        totalPages = Math.ceil(filteredCards.length / itemsPerPage);
        currentPage = 1; // Reset to the first page
        renderPaginationControls();
        updatePageIndicator();
    }

    // Initialize pagination on page load
    window.onload = initializePagination;</script>
