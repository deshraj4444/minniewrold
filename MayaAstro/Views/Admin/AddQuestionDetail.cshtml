@model MayaAstro.Models.QuestionDetailVM
@{

    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
}
<style>
    .submit-button-right {
        background-color: #0f4989 !important;
        color: white !important;
        float: right;
    }

        .submit-button-right:hover {
            background-color: #c9c6c22b !important;
            color: #0f4989 !important;
            float: right;

</style>
<main id="main" class="main">
    <div class="pagetitle">
        <h1>Add Question Detail</h1>
    </div>

    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <div class="auto-container">
                            <div class="sec-title">
                                <div class="clearfix">
                                    <div class="pull-left">
                                        <div class="title"> Add Question Detail</div>

                                    </div>
                                    <div class="pull-right">
                                        <div class="text">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Contact Form -->
                            @using (Html.BeginForm("SaveQuestionDetail", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))

                            {
                                @Html.HiddenFor(x => x.Id)

                                <div class="row clearfix">
                                    <div class="col-md-6 about-section-top mt-3">
                                        <label class="admin-panel-label">Question Category</label>
                                        @Html.DropDownListFor(m => m.QuestionId, new SelectList(Model.QuestionList, "Id", "Title"), "-- Select Category --", new { @class = "form-control nice-select wide", required = "required" })
                                        @Html.ValidationMessageFor(model => model.QuestionId, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group col-lg-6 col-md-6 col-sm-12 mt-3">
                                        <label for="Title">Answer </label>
                                        @Html.EditorFor(model => model.Answer, new { htmlAttributes = new { @class = "form-control", required = "required", placeholder = "" } })
                                        @Html.ValidationMessageFor(model => model.Answer, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="form-group col-lg-6 col-md-6 col-sm-12 mt-3">
                                        <label for="IsQuestionActive">Is True?</label>
                                        @Html.CheckBoxFor(model => model.IsTrue, new { @class = "form-check-input" })
                                        @Html.ValidationMessageFor(model => model.IsTrue, "", new { @class = "text-danger" })
                                    </div>

                                   
                                    <div class="form-group text-center col-lg-12 col-md-12 col-sm-12 mb-3">
                                        <input type="submit" class="btn submit-button-right" value="Submit" />
                                        @*<button class="theme-btn btn-style-three" type="submit"><span class="txt">Save</span></button>*@
                                    </div>
                                </div>


                            }

                        </div>
                        <section class="section">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <h5 class="card-title">Question Detail List</h5>


                                            <!-- Table with stripped rows -->
                                            <table id="example" class="table datatable">
                                                <thead>
                                                    <tr>
                                                        <th>SNo</th>
                                                        <th> Answer</th>
                                                        <th>Question Name</th>
                                                        <th>Is True</th>
                                                        <th>Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model?.QuestionDetailList?.Any() == true)
                                                    {
                                                        var Sl = 1;
                                                        foreach (var item in Model.QuestionDetailList)
                                                        {
                                                            <tr>
                                                                <td>@Sl</td>
                                                                <td>@item.Answer</td>
                                                                <td>@item.QuestionName</td>
                                                                <td>@item.IsTrue</td>
                                                                <td class="table-action-btn">
                                                                    <div class="sorting_1 pt-4 pb-3">
                                                                        <a href="~/Admin/AddQuestionDetail/@item.Id" type="button" class="">
                                                                            <i class="bi bi-pencil-square" data-toggle="tooltip" data-placement="top" title="Edit"></i>

                                                                        </a>
                                                                        <a href="/Admin/DeleteQuestionDetail/?id=@item.Id" class="" onclick="return confirm('Are you sure you wish to Delete This ?')">
                                                                            <i class="bi bi-trash3-fill" data-toggle="tooltip" data-placement="top" title="Remove"></i>

                                                                        </a>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                            Sl++;
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="8">No Question available.</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            <!-- End Table with stripped rows -->

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
