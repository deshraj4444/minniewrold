@model UserVM

@{
    ViewData["Title"] = "Register User";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h2>Register User</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div  id= "main" class="alert alert-success">@TempData["SuccessMessage"]</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div id= "main" class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
<main id="main" class="main">
<section class="section">
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <form asp-action="Register" asp-controller="Admin" method="post">
                        <div class="form-group">
                            <label asp-for="FirstName"></label>
                            <input asp-for="FirstName" class="form-control" required />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="LastName"></label>
                            <input asp-for="LastName" class="form-control" required />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                                <div class="form-group">
                                    <label asp-for="Email"></label>
                                    <input asp-for="Email" type="email" id="Email" class="form-control" required />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                    <span id="emailError" class="text-danger"></span> <!-- ✅ Add this -->
                                </div>

                        <div class="form-group">
                            <label asp-for="Password"></label>
                            <input asp-for="Password" type="password" class="form-control" required />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <button type="submit" id="registerButton" class="btn btn-primary">Register</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
</section>
</main>
<script>
    $(document).ready(function () {
        $("#Email").on("blur", function () {
            var email = $(this).val().trim();

            if (email) {
                $.ajax({
                    url: "/Admin/EmailAlreadyExist",
                    type: "GET",
                    data: { Emailline: email },
                    success: function (response) {
                        $("#emailError").text(response.status ? response.message : "").css("color", "red");
                    },
                    error: function () {
                        $("#emailError").text("Error checking email. Please try again.").css("color", "red");
                    }
                });
            }
        });
    });
</script>



