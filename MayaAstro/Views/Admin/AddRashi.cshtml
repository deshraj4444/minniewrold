@model MayaAstro.Models.RashiVM
@{
    var type = !string.IsNullOrEmpty(this.Context.Request.Query["type"]) ? this.Context.Request.Query["type"].ToString() : "0";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration;
    var uploadUrl = Configuration["ApiSettings:UploadURL"];
}

<style>
    .submit-button-right {
        background-color: #0f4989 !important;
        color: white !important;
        float: right;
    }

        .submit-button-right:hover {
            background-color: #c9c6c22b !important;
            color: #0f4989 !important;
            float: right;
        }
</style>

<main id="main" class="main">
    <div class="pagetitle">
        <h1>Add Rashi</h1>
    </div>

    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        @using (Html.BeginForm("SaveRashi", "Admin", new { Type = type }, FormMethod.Post, false, new { id = "frmUserDetails", enctype = "multipart/form-data" }))
                        {
                            @Html.HiddenFor(model => model.Id)
                           @*  @Html.HiddenFor(model => model.ImageUrl) *@
                           
                            <div class="card">
                                <div class="card-body">
                                   <div class="col-md-6">
                                    <label class="admin-panel-label" for="Image">Upload Rashi Image</label>
                                    <div class="form-group">
                                        <div class="custom-file">
                                            <input type="file"
                                                   class="form-control nice-select wide"
                                                   id="Image"
                                                   name="Image"
                                                   onchange="showImage(this)"
                                                   accept="image/*">
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 text-center">
                                    <div class="upload-img mt-3">
                                        <!-- Display selected image preview -->
                                        <img id="selectedImage"
                                             src="@Model.ImageUrl"
                                             alt="Selected Image"
                                             class="profile-pic"
                                             style="max-height: 100px; display:@(Model.ImageUrl != null ? "block" : "none");" />
                                    </div>
                                </div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label>Rashi Name</label>
                                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                                        </div>
                                        <div class="col-md-12">
                                            <input type="submit" class="btn submit-button-right" value="Submit" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        <section class="section">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <h5 class="card-title"> Rashi List</h5>

                                            <div class="row-search-enquiry mt-3" style="display: flex; flex-direction: row; justify-content: space-between;">
                                               
                                                <div class="col-lg-2">
                                                    <div class="input-group">
                                                        <label class="mx-2 mt-2">Entries per page: </label>
                                                        <select id="entriesPerPage" class="form-select" onchange="initializePagination()">
                                                            <option value="10" selected="">10</option>
                                                            <option value="20">20</option>
                                                            <option value="30">30</option>
                                                            <option value="50">50</option>
                                                        </select>
                                                    </div>
                                                </div>

                                                <!-- Search Box -->
                                                <div class="col-lg-3">
                                                    <div class="input-group mb-3">
                                                        <label class="mx-2 mt-2">Search: </label>
                                                        <input type="text" class="form-control" id="searchInput" placeholder="Search by Title" onkeyup="filterItems()" />
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row" id="cardContainer">
                                                @if (Model?.RashiList?.Any() == true)
                                                {
                                                    foreach (var rashis in Model.RashiList)
                                                    {
                                                        <div class="col-lg-4 col-md-6 mb-4 card-item product-card">
                                                            <div class="card">
                                                                <div class="action-buttons" style="position: absolute; top: 10px; right: 10px;">
                                                                    <a class="btn btn-sm" href="@Url.Action("AddRashi", "Admin", new { id = rashis.Id })" title="Edit">
                                                                        <i class="fas fa-edit"></i>
                                                                    </a>
                                                                    <a class="btn btn-sm" href="@Url.Action("DeleteRashi", "Admin", new { id = rashis.Id })" title="Delete" onclick="return confirm('Are you sure you want to delete this rashi?');">
                                                                        <i class="fas fa-trash"></i>
                                                                    </a>
                                                                </div>
                                                                <div class="card-body">
                                                                    <img src="@uploadUrl@rashis.ImageUrl" alt="Image" class="card-img-top mb-lg-3 mb-md-2 mb-sm-2" style="width: 100%; height: 200px; object-fit: cover;" />
                                                                    <h5 class="card-title">@Html.DisplayFor(modelItem => rashis.Name)</h5>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="col-lg-12">
                                                        <div class="card">
                                                            <div class="card-body">
                                                                <p>No Items available.</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>

                                            <!-- Pagination Control -->
                                            <nav aria-label="Page navigation">
                                                <ul class="pagination justify-content-center" id="paginationControls"></ul>
                                            </nav>

                                            <!-- Page Indicator -->
                                            <div id="pageIndicator" class="text-center mt-3"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<!-- Required Scripts -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    @functions {
        public string TruncateToWords(string text, int wordCount)
        {
            if (string.IsNullOrWhiteSpace(text)) return string.Empty;

            var words = text.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
            return string.Join(" ", words.Take(wordCount)) + (words.Length > wordCount ? "..." : "");
        }
    }
    let itemsPerPage = 10; // Default number of items per page
    let currentPage = 1; // Current page
    let totalPages = 0; // Total pages
    let filteredCards = null; // To store filtered cards

    // Initialize pagination
    function initializePagination() {
        const productCards = document.querySelectorAll('.product-card');
        itemsPerPage = parseInt(document.getElementById("entriesPerPage").value); // Get selected items per page
        totalPages = Math.ceil(productCards.length / itemsPerPage);
        currentPage = 1; // Reset to the first page
        renderPage(currentPage);
        renderPaginationControls();
        updatePageIndicator();
    }

    // Render a specific page of cards
    function renderPage(page) {
        const productCards = filteredCards || document.querySelectorAll('.product-card');
        const start = (page - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        productCards.forEach((card, index) => {
            card.style.display = (index >= start && index < end) ? "block" : "none"; // Show or hide cards based on page
        });
    }

    // Render pagination controls
    function renderPaginationControls() {
        const paginationControls = document.getElementById("paginationControls");
        paginationControls.innerHTML = ""; // Clear existing controls
        const productCards = filteredCards || document.querySelectorAll('.product-card');
        totalPages = Math.ceil(productCards.length / itemsPerPage);

        // Add "Previous" button
        if (currentPage > 1) {
            const prevLi = document.createElement("li");
            prevLi.className = "page-item";
            prevLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage - 1})">Previous</a>`;
            paginationControls.appendChild(prevLi);
        }

        // Show first pages (1, 2, 3)
        const pageRange = 3;
        for (let i = 1; i <= Math.min(pageRange, totalPages); i++) {
            const li = document.createElement("li");
            li.className = `page-item ${i === currentPage ? 'active' : ''}`;
            li.innerHTML = `<a class="page-link" href="#" onclick="changePage(${i})">${i}</a>`;
            paginationControls.appendChild(li);
        }

        // Add ellipsis if needed
        if (totalPages > pageRange + 1) {
            const ellipsisLi = document.createElement("li");
            ellipsisLi.className = "page-item disabled";
            ellipsisLi.innerHTML = `<span class="page-link">...</span>`;
            paginationControls.appendChild(ellipsisLi);
        }

        // Show last page if needed
        if (totalPages > pageRange) {
            const lastLi = document.createElement("li");
            lastLi.className = "page-item";
            lastLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${totalPages})">${totalPages}</a>`;
            paginationControls.appendChild(lastLi);
        }

        // Add "Next" button
        if (currentPage < totalPages) {
            const nextLi = document.createElement("li");
            nextLi.className = "page-item";
            nextLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage + 1})">Next</a>`;
            paginationControls.appendChild(nextLi);
        }
    }

    // Change the current page
    function changePage(page) {
        currentPage = page;
        renderPage(currentPage);
        renderPaginationControls();
        updatePageIndicator();
    }

    // Update the page indicator
    function updatePageIndicator() {
        const pageIndicator = document.getElementById("pageIndicator");
        pageIndicator.innerHTML = `Page ${currentPage} of ${totalPages}`; // Update the text
    }

    // Filter cards based on search input and category
    function filterCards() {
        const searchInput = document.getElementById("searchInput").value.toLowerCase();
        const selectedCategory = document.getElementById("categoryFilter").value;
        const cards = document.querySelectorAll(".product-card");

        filteredCards = Array.from(cards).filter(card => {
            const productName = card.getAttribute("data-name").toLowerCase();
            const productCategory = card.getAttribute("data-category");

            const nameMatches = productName.includes(searchInput);
            const categoryMatches = !selectedCategory || productCategory === selectedCategory;

            return nameMatches && categoryMatches;
        });

        // Hide all cards first
        cards.forEach(card => card.style.display = "none");

        // Show filtered cards
        filteredCards.forEach((card, index) => {
            card.style.display = (index < itemsPerPage) ? "block" : "none";
        });

        // Update total pages based on filtered cards
        totalPages = Math.ceil(filteredCards.length / itemsPerPage);
        currentPage = 1; // Reset to the first page
        renderPaginationControls();
        updatePageIndicator();
    }

    // Initialize pagination on page load
    window.onload = initializePagination;</script>
