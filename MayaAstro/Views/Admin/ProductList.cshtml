@model MayaAstro.Models.ProductDetailVM 
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration;
    var uploadUrl = Configuration["SendGridEmail:UploadURL"];
}
<main id="main" class="main">
    <section class="section">
        <div class="row">
            <div class="col-lg-12">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Product List</h5>
                        <div class="row-search-enquiry mb-3" style="display: flex;
  justify-content: space-between;">
                            <div class="col-lg-6 d-flex justify-content-space-between">
                                <div class="input-group me-3">
                                    <label class="mx-2 mt-2">Entries per page: </label>
                                    <select id="entriesPerPage" class="form-select" onchange="initializePagination()">
                                        <option value="5">5</option>
                                        <option value="10" selected>10</option>
                                        <option value="15">15</option>
                                        <option value="20">20</option>
                                    </select>
                                </div>
                                <div class="input-group">
                                    <label class="mx-2 mt-2">Category: </label>
                                    <select id="categoryFilter" class="form-select" onchange="filterCards()">
                                        <option value="">All Categories</option>
                                        @foreach (var category in Model.ProductList)
                                        {
                                            <option value="@category.Id">@category.ProductCategoryName</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="input-group">
                                    <label class="mx-2 mt-2">Search: </label>
                                    <input type="text" id="searchInput" class="form-control" placeholder="Search..." onkeyup="filterCards()">
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mt-4" id="productCards">
                            @if (Model?.AllProductList?.Any() == true)
                            {
                                foreach (var product in Model.AllProductList)
                                {
                                    <div class="col-lg-3 col-md-6 mb-4 product-card" data-name="@product.Title" data-category="@product.ProductCategoryId">
                                        <div class="card">
                                            <div class="position-relative">
                                                <img src="@uploadUrl@product.BannerImageUrl" alt="Image" class="card-img-top" style="width: 100%; height: 200px; object-fit: cover;" />
                                                <div class="action-buttons position-absolute top-0 end-0 p-2">
                                                    <a class="btn btn-sm me-1" href="@Url.Action("Products", "Admin", new { id = product.Id })" title="Edit"><i class="fas fa-edit"></i></a>
                                                    <a class="btn btn-sm" href="@Url.Action("DeleteProduct", "Admin", new { id = product.Id })" title="Delete" onclick="return confirm('Are you sure you want to delete this product?');">
                                                        <i class="fas fa-trash"></i>
                                                    </a>
                                                </div>
                                            </div>
                                            <div class="card-body">
                                                <h5 class="card-title">@Html.DisplayFor(modelItem => product.Title)</h5>
                                                <p class="card-text">@Html.Raw(product.ProductCategoryName)</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="col-lg-12">
                                    <div class="alert alert-warning" role="alert">
                                        No Products available.
                                    </div>
                                </div>
                            }
                        </div> <!-- End of row -->
                        <!-- Pagination Controls -->
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center" id="paginationControls"></ul>
                        </nav>

                        <!-- Page Indicator -->
                        <div id="pageIndicator" class="text-center mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>

<script>
    let itemsPerPage = 10; // Default number of items per page
    let currentPage = 1; // Current page
    let totalPages = 0; // Total pages
    let filteredCards = null; // To store filtered cards

    // Initialize pagination
    function initializePagination() {
        const productCards = document.querySelectorAll('.product-card');
        itemsPerPage = parseInt(document.getElementById("entriesPerPage").value); // Get selected items per page
        totalPages = Math.ceil(productCards.length / itemsPerPage);
        currentPage = 1; // Reset to the first page
        renderPage(currentPage);
        renderPaginationControls();
        updatePageIndicator();
    }

    // Render a specific page of cards
    function renderPage(page) {
        const productCards = filteredCards || document.querySelectorAll('.product-card');
        const start = (page - 1) * itemsPerPage;
        const end = start + itemsPerPage;

        productCards.forEach((card, index) => {
            card.style.display = (index >= start && index < end) ? "block" : "none"; // Show or hide cards based on page
        });
    }

    // Render pagination controls
    function renderPaginationControls() {
        const paginationControls = document.getElementById("paginationControls");
        paginationControls.innerHTML = ""; // Clear existing controls
        const productCards = filteredCards || document.querySelectorAll('.product-card');
        totalPages = Math.ceil(productCards.length / itemsPerPage);

        // Add "Previous" button
        if (currentPage > 1) {
            const prevLi = document.createElement("li");
            prevLi.className = "page-item";
            prevLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage - 1})">Previous</a>`;
            paginationControls.appendChild(prevLi);
        }

        // Show first pages (1, 2, 3)
        const pageRange = 3;
        for (let i = 1; i <= Math.min(pageRange, totalPages); i++) {
            const li = document.createElement("li");
            li.className = `page-item ${i === currentPage ? 'active' : ''}`;
            li.innerHTML = `<a class="page-link" href="#" onclick="changePage(${i})">${i}</a>`;
            paginationControls.appendChild(li);
        }

        // Add ellipsis if needed
        if (totalPages > pageRange + 1) {
            const ellipsisLi = document.createElement("li");
            ellipsisLi.className = "page-item disabled";
            ellipsisLi.innerHTML = `<span class="page-link">...</span>`;
            paginationControls.appendChild(ellipsisLi);
        }

        // Show last page if needed
        if (totalPages > pageRange) {
            const lastLi = document.createElement("li");
            lastLi.className = "page-item";
            lastLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${totalPages})">${totalPages}</a>`;
            paginationControls.appendChild(lastLi);
        }

        // Add "Next" button
        if (currentPage < totalPages) {
            const nextLi = document.createElement("li");
            nextLi.className = "page-item";
            nextLi.innerHTML = `<a class="page-link" href="#" onclick="changePage(${currentPage + 1})">Next</a>`;
            paginationControls.appendChild(nextLi);
        }
    }

    // Change the current page
    function changePage(page) {
        currentPage = page;
        renderPage(currentPage);
        renderPaginationControls();
        updatePageIndicator();
    }

    // Update the page indicator
    function updatePageIndicator() {
        const pageIndicator = document.getElementById("pageIndicator");
        pageIndicator.innerHTML = `Page ${currentPage} of ${totalPages}`; // Update the text
    }

    // Filter cards based on search input and category
    function filterCards() {
        const searchInput = document.getElementById("searchInput").value.toLowerCase();
        const selectedCategory = document.getElementById("categoryFilter").value;
        const cards = document.querySelectorAll(".product-card");

        filteredCards = Array.from(cards).filter(card => {
            const productName = card.getAttribute("data-name").toLowerCase();
            const productCategory = card.getAttribute("data-category");

            const nameMatches = productName.includes(searchInput);
            const categoryMatches = !selectedCategory || productCategory === selectedCategory;

            return nameMatches && categoryMatches;
        });

        // Hide all cards first
        cards.forEach(card => card.style.display = "none");

        // Show filtered cards
        filteredCards.forEach((card, index) => {
            card.style.display = (index < itemsPerPage) ? "block" : "none";
        });

        // Update total pages based on filtered cards
        totalPages = Math.ceil(filteredCards.length / itemsPerPage);
        currentPage = 1; // Reset to the first page
        renderPaginationControls();
        updatePageIndicator();
    }

    // Initialize pagination on page load
    window.onload = initializePagination;</script>