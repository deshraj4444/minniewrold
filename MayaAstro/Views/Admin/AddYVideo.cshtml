@model MayaAstro.Models.BlogDetailVM@{	Layout = "~/Views/Shared/_AdminLayout.cshtml";}<style>	.submit-button {		background-color: #0f4989 !important;		color: white !important;		float: right;	}		.submit-button:hover {			background-color: #c9c6c22b !important;			color: #0f4989 !important;		}	.submit-button-right {		background-color: #0f4989 !important;		color: white !important;	}		.submit-button-right:hover {			background-color: #c9c6c22b !important;			color: #0f4989 !important;		}</style><main id="main" class="main">	<div class="pagetitle">		<h1>Youtube Videos</h1>	</div><!-- End Page Title -->	<section class="section">		<div class="row">			<div class="col-lg-12">				<div class="card">					<div class="card-body">						<div class="d-flex justify-content-between align-items-center">							<h5 class="card-title">Add YVideo</h5>							<a href="@Url.Action("AddYVideoCategory", "Admin")" class="btn submit-button-right">Add YVideos Category</a>						</div>						@using (Html.BeginForm("SaveYoutubeVideo", "Admin", new { TypeId = Model.TypeId == 0 ? 4 : Model.TypeId }, FormMethod.Post, false, new { id = "frmUserDetails", enctype = "multipart/form-data" }))							{								@Html.HiddenFor(model => model.Id)							@Html.HiddenFor(model => model.ButtonUrl)							@Html.HiddenFor(model => model.ThumbnailImageUrl)							<div class="card mt-3">								<div class="card-body">									<div class="row g-3">										<div class="col-md-6" style="display: none;">										<label class="admin-panel-label">website</label>											<div class="form-check">												@Html.RadioButtonFor(m => m.WebsiteId, 1, new { @class = "form-check-input", id = "mayaastro" })												<label class="form-check-label" for="mayaastro">mayaastro</label>											</div>											<div class="form-check">												@Html.RadioButtonFor(m => m.WebsiteId, 2, new { @class = "form-check-input", id = "mayait" })												<label class="form-check-label" for="mayait">mayait</label>											</div>									</div>									</div>																								<div class="col-md-6">										<label class="admin-panel-label" for="Image">Upload Thumbnail Image</label>										<div class="form-group">											<div class="custom-file">												<input type="file"													   class="form-control nice-select wide"													   id="ThumbnailImage"													   name="ThumbnailImage"													   onchange="showThumbnailImage(this)"													   accept="image/*">											</div>										</div>									</div>									<div class="col-md-6 text-center">										<div class="upload-img mt-3">																			<img id="selectedThumbnailImage"												 src="@Model.ThumbnailImageUrl"												 alt="Selected Thumbnail Image"												 class="profile-pic"												 style="max-height: 100px; display:@(Model.ThumbnailImageUrl != null ? "block" : "none");" />										</div>									</div>									<div class="col-md-6 about-section-top">										<label class="admin-panel-label">Alt tag</label>										@Html.TextBoxFor(m => m.SeoTitle, new { @class = "form-control" })									</div>								<!-- Upload Author Image Section -->								<div class="col-md-6">									<label class="admin-panel-label" for="AuthorImage">Upload Author Image</label>									<div class="form-group">										<div class="custom-file">											<input type="file"												   class="form-control nice-select wide"												   id="AuthorImage"												   name="AuthorImage"												   onchange="showAuthorImage(this)"												   accept="image/*">										</div>									</div>								</div>								<div class="col-md-6 text-center">									<div class="upload-img mt-3">										<!-- Display selected author image preview -->										<img id="selectedAuthorImage"											 src="@Model.ButtonUrl"											 alt="Selected Author Image"											 class="profile-pic"											 style="max-height: 100px; display:@(Model.ButtonUrl != null ? "block" : "none");" />									</div>								</div>							</div>							<!-- Additional Fields -->								<div class="col-md-6">									<label class="admin-panel-label">PageUrl</label>									@Html.TextBoxFor(m => m.PageUrl, new { @class = "form-control", required = "required" })								</div>							<div class="row g-3">								<div class="col-md-6">									<label class="admin-panel-label">Title</label>									@Html.TextBoxFor(m => m.Title, new { @class = "form-control", required = "required" })								</div>																	<div class="col-md-12">										<label class="admin-panel-label">VideoUrl</label>										@Html.TextAreaFor(m => m.Description, new { @class = "form-control " })									</div>								<div class="col-md-6">									<label class="admin-panel-label">Author</label>									@Html.TextBoxFor(m => m.Author, new { @class = "form-control", required = "required" })								</div>								<div class="col-md-6">									<label class="admin-panel-label">Publish Date</label>									@Html.TextBoxFor(m => m.PublishDate, "{0:yyyy-MM-dd}", new { @class = "form-control", @type = "date", value = DateTime.Now.ToString("yyyy-MM-dd") })									@Html.ValidationMessageFor(m => m.PublishDate, "", new { @class = "text-danger" })								</div>									<div class="row g-3">										<div class="col-md-6">											<label class="admin-panel-label">Publish Status</label>											<div class="form-check">												@Html.RadioButtonFor(m => m.IsPublished, 1, new { @class = "form-check-input", id = "Published" })												<label class="form-check-label" for="Published">Published</label>											</div>											<div class="form-check">												@Html.RadioButtonFor(m => m.IsPublished, 0, new { @class = "form-check-input", id = "NotPublished" })												<label class="form-check-label" for="NotPublished">Not Published</label>											</div>										</div>									</div>								</div>							</div>							<div class="row g-3">								<div class="card">									<div class="card-body">										<h5 class="card-title">SEO</h5>										<div class="row">											<div class="col-md-6 about-section-top">												<label class="admin-panel-label">Youtube Meta Title</label>												@Html.TextBoxFor(m => m.BlogMetaTitle, new { @class = "form-control" })											</div>										  										   										</div>										<div class="row">											<div class="col-md-6 about-section-top">												<label class="admin-panel-label">Youtube Meta Description</label>												@Html.TextAreaFor(m => m.BlogMetaDescription, new { @class = "form-control" })											</div>											<div class="col-md-6 about-section-top">												<label class="admin-panel-label">Youtube Meta Keyword</label>												@Html.TextAreaFor(m => m.BlogMetaKeyword, new { @class = "form-control" })											</div>										</div>										<div class="row">											<div class="col-md-6 about-section-top">												<label class="admin-panel-label">Youtube Meta Content</label>												@Html.TextAreaFor(m => m.BlogMetaContent, new { @class = "form-control" })											</div>										</div>									</div>								</div>							</div>							<div class="col-md-12">								<input type="submit" class="btn submit-button ms-5 mt-3" value="Submit" />							</div>						}					</div>				</div>			</div>		</div>	</section></main><!-- Scripts --><script src="https://code.jquery.com/jquery-3.6.0.min.js"></script><script src="~/js/ckeditor5-35.4.0-clasic/build/ckeditor.js"></script><script src="~/js/ckeditor (1).js"></script><!-- Image Preview JavaScript --><script>	function showImage(input) {		if (input.files && input.files[0]) {			var reader = new FileReader();			reader.onload = function (e) {				$('#selectedImage').attr('src', e.target.result).show();			};			reader.readAsDataURL(input.files[0]);		}	}	function showAuthorImage(input) {		if (input.files && input.files[0]) {			var reader = new FileReader();			reader.onload = function (e) {				$('#selectedAuthorImage').attr('src', e.target.result).show();			};			reader.readAsDataURL(input.files[0]);		}	}	function showThumbnailImage(input) {		if (input.files && input.files[0]) {			var reader = new FileReader();			reader.onload = function (e) {				$('#selectedThumbnailImage').attr('src', e.target.result).show();			};			reader.readAsDataURL(input.files[0]);		}	}</script>