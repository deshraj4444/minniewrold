<section class="as_overview_wrapper pt-0">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center mt-5">
                <h1 class="as_heading as_heading_center">Daily Planetary Overview</h1>
                <p class="text-white">Gain insights into today’s celestial movements to align your goals actions<br> and energy with the universe.</p>



                <div class="as_overview_slider">
                    <div class="as_overview_inner">
                        <p class="as_font14">Discover the influence of celestial movements on your day. By understanding the alignment of planets and their impact you can harness their energy to make better decisions optimize your actions and stay aligned with your goals empowering you to navigate life’s opportunities and challenges with confidence.</p>
                        <span class="as_btn"><i class="bi bi-calendar2-check"></i>July 29, 2020</span>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>