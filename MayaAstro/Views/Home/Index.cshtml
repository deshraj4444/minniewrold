<section class="as_blog_wrapper as_padderTop80 as_padderBottom80">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <h1 class="as_heading as_heading_center">Our Latest Blog</h1>
                <p class="as_font14 as_margin0 as_padderBottom20">Explore engaging topics insightful tips and inspiring stories to keep you informed motivated <br>and empowered every day.</p>

                <div class="text-left">
                    <div class="row">
                        @if (Model != null && Model.BlogList != null && Model.BlogList.Count() > 0)
                        {
                            @foreach (var blog in Model.BlogList)
                            {
                                <div class="col-lg-4 col-md-6 col-sm-12 col-12">
                                    <div class="as_blog_boxcard">
                                        <div class="as_blog_img">
                                            <a href="/@Slugify(blog.PageUrl)">
                                                <img src="@uploadUrl@blog.ThumbnailImageUrl" alt="@blog.BannerAltText" class="img-fluid">
                                            </a>
                                            <span class="as_btn">@blog.PublishDate?.ToString("MMMM dd, yyyy")</span>
                                        </div>

                                        <h4 class="as_subheading">
                                            <a href="/@Slugify(blog.PageUrl)">@blog.Title</a>
                                        </h4>


                                        @if (blog.IsShowButton)
                                        {
                                            <a href="@blog.ButtonUrl" class="as_btn text-white">@blog.ButtonText</a>
                                        }
                                    </div>
                                </div>
                            }
                        }


                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
