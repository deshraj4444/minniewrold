@model MayaAstro.Models.IndexPageVM
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Welcome to MayaAstro: A Journey of Faith and Inspiration"
        ;
    Layout = "~/Views/Shared/_Layout.cshtml";
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration;
    var uploadUrl = Configuration["ApiSettings:UploadURL"];
    var today = DateOnly.FromDateTime(DateTime.Today);
}
@{
    string[] signs = {
        "Aries", "Taurus", "Gemini", "Cancer", "Leo",
        "Virgo", "Libra", "Scorpio", "Sagittarius",
        "Capricorn", "Aquarius", "Pisces"
    };
}
@functions {
    public string Slugify(string title)
    {
        if (string.IsNullOrEmpty(title))
            return string.Empty;
        return title.Trim().Replace(" ", "-");
    }
}
<section class="as_banner_wrapper">
    <div class="container-fluid">
        <div class="row as_verticle_center">
            <div class="col-lg-6 order-lg-1 col-md-6 order-md-1 col-sm-12 order-sm-1 col-12 order-2">
                <div class="as_banner_slider">
                    @if (Model.HoroscopeVM != null && Model.HoroscopeVM.Any(h => h.Date == today))
                    {
                        foreach (var horoscope in Model.HoroscopeVM.Where(h => h.Date == today))
                        {
                            <div class="as_banner_detail">
                                <h1>@horoscope.Title</h1>
                                <p>@Html.Raw(horoscope.LongDescription)</p>
                                <p class="as_date">Date: @horoscope.Date.ToString("yyyy-MM-dd")</p>
                            </div>
                        }
                    }
                    else if (Model.Horoscopes != null && Model.Horoscopes.Any())

                    {
                        int index = 0;
                        foreach (var horoscope in Model.Horoscopes)
                        {
                            var sign = signs[index];
                            index++;
                            <div class="as_banner_detail">
                                <h5 class="as_orange">Sign: @sign</h5>
                                <h1>Daily Horoscope for @sign</h1>
                                <p>@horoscope.Horoscope_Data</p>
                                <p class="as_date">Date: @horoscope.Date</p>
                            </div>
                        }
                    }

                </div>
            </div>
            <div class="col-lg-6 order-lg-2 col-md-6 order-md-2 col-sm-12 order-sm-2 col-12 order-1">
                <div class="as_banner_img text-center">
                    <img src="~/img/banner_image.png" alt="" class="img-fluid">
                </div>
            </div>
        </div>
    </div>
</section>
<section>
    <div class="container-fluid px-0 position-relative">

        <div class="header-slider">
        </div>
    </div>

</section>


