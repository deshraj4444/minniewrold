@using System.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @if (ViewBag.BlogMetaTitle == null)
    {
        <meta property="title" content="Hinduism and Spiritual Practices" />
        <meta property="title" content="Discover the profound spiritual practices of Hinduism, exploring rituals, meditation, yoga, and their deep connection to mindfulness and inner peace. Unveil the wisdom of ancient traditions that inspire harmony and self-realization" />

    }
    else
    {
        <meta property="title" content="@Html.Raw(HttpUtility.HtmlDecode(ViewBag.BlogMetaTitle))" />
        <meta property="og:title" content="@Html.Raw(HttpUtility.HtmlDecode(ViewBag.SeoTitle))" />
        <meta property="description" content="@Html.Raw(HttpUtility.HtmlDecode(ViewBag.BlogMetaDescription))" />
        <meta property="og:description" content="@Html.Raw(HttpUtility.HtmlDecode(ViewBag.BlogMetaContent))" />
        <meta property="Keyword" content="@Html.Raw(HttpUtility.HtmlDecode(ViewBag.BlogMetaKeyword))" />
    }



    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" type="text/css" href="~/css/slick.css?v=1.0">
    <link rel="stylesheet" type="text/css" href="~/css/style.css?v=1.0">

    <title>@ViewData["Title"] - MayaAstro</title>
    <link href="~/img/logo.png" rel="icon">

</head>
<body>

    <div class="hs_top_header_main_Wrapper">
        <div class="container d-flex">
            <div class="hs_header_logo_left hidden-xs">
                <div class="hs_logo_wrapper">
                    <a href="/"><img src="~/img/logo.png" class="img-responsive" alt="logo" title="Logo" /></a>
                </div>
            </div>
            <div class="hs_header_logo_right">


                <div class="hs_header_add_wrapper hidden-xs hidden-sm">
                    <div class="hs_header_add_icon">
                        <i class="bi bi-geo-alt fs-2"></i>
                    </div>
                    <div class="hs_header_add_icon_cont">
                        <h5>Address</h5>
                        <p>Bhojpur,Near Dental College Sundernagar</p>
                       
                    </div>
                </div>

                
                <div class="hs_header_add_wrapper hidden-xs hidden-sm">
                    <div class="hs_header_add_icon">
                        <i class="bi bi-envelope-paper fs-2"></i>
                    </div>
                    <div class="hs_header_add_icon_cont">
                        <h5>E-Mail</h5>
                        <p> mayait.corporate@gmail.com</p>

                    </div>
                </div>


                <div class="hs_header_add_wrapper hidden-xs hidden-sm">
                    <div class="hs_header_add_icon">
                        <i class="bi bi-telephone-outbound-fill"></i>
                    </div>
                    <div class="hs_header_add_icon_cont">
                        <h5>Talk to Astrologers</h5>
                        <p>+91-96462-22201</p>
                    </div>
                </div>




            </div>
        </div>
    </div>
    <header>
        <!-- Mobile Menu Toggle -->
        

     <nav class="navbar navbar-expand-lg">
            <div class="container">

                <button class="navbar-toggler ms-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown" aria-controls="navbarNavDropdown" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"><i class="bi bi-list"></i></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item ps-00">
                            <a class="nav-link" aria-current="page" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/about">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/blog">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/videos/">Videos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/services">Services</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/acharya">Acharya</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/contact">
                                Contact
                            </a>
                        </li>
                    </ul>
                    <div class="navbar-right ms-auto">
                    </div>
                </div>
            </div>
        </nav> 
    </header>

    @RenderBody()
    <div class="hs_bottom_footer_main_wrapper">
        <a href="javascript:" id="return-to-top"><i class="fa fa-angle-up"></i></a>
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                    <div class="footer_bottom_cont_wrapper">
                        <p><i class="bi bi-c-circle"></i> Copyright 2024-2025 by MAYA IT. All right Reserved </p>
                    </div>
                    <div class="row">
                        <div class="col-lg-12 col-md-12 footer-privacy-policy">
                            <a class="nav-link-privacy" href="/privacy-policy">Privacy Policy </a>
                            <span class="footer-line"> | </span>
                            <a class="nav-link-privacy" href="/term-of-use">Term & Conditions</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/slick.min.js"></script>
    <script src="~/js/main.js"></script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-GTFL83KLMF"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-GTFL83KLMF');
    </script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5066054042272431"
            crossorigin="anonymous"></script>
</body>
</html>
