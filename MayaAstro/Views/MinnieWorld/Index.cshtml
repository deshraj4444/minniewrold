@model MayaAstro.Models.ContactsVM
@{
    ViewData["Title"] = "Who We Are: Sharing Love, Hope, and Spiritual Guidance";
    Layout = "~/Views/Shared/_MinnieWorldLayout.cshtml";
}

<section>
    <div class="row py-3 headerbanner">
        <div class="col rounded">
            <div id="carouselExampleIndicators" class="carousel slide shadow-sm" data-bs-ride="true">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active"
                    aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"
                    aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"
                    aria-label="Slide 3"></button>
                    <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="3"
                    aria-label="Slide 4"></button>
                </div>
                <div class="carousel-inner rounded">
                    <div class="carousel-item active">
                        <img src="Wall_panel_img/slider_3 .png" class="d-block w-100 img-fluid" alt="...">
                        <div class="w-100  minnieworld-blog  position-absolute top-0 start-0 d-flex ">
                            <h3>
                                Elevate Your Space with Understated Art

                            </h3>
                            <p>"Captivating Elegance, Enchanting Serenity"</p>
                        </div>
                    </div>
                    <div class="carousel-item">
                        <img src="Wall_panel_img/slider 1.webp" class="img-fluid d-block w-100" alt="...">
                        <div class="w-100 h-100 minnieworld-blog position-absolute top-0 end-0 d-flex text-end">
                            <h3>
                                Discover the Unseen, Through Colors

                            </h3>
                            <p>"Art That Opens Doors to New Worlds"</p>
                        </div>
                    </div>


                </div>
                <button class="carousel-control-prev justify-content-start px-5" type="button"
                data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                    <p aria-hidden="true">&#10094;</p>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next justify-content-end px-5" type="button"
                data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                    <p aria-hidden="true">&#10095;</p>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>
    </div>
</section>
