<?xml version="1.0" encoding="utf-8"?>
<!--
  Web Deploy to SmarterASP.NET (minnieworld.com).

  Fill in the three YOUR-... values from the SmarterASP control panel:
  Websites → your site → Deployment / Show Web Deploy Info (enable Web Deploy first).
    MSDeployServiceURL  e.g. https://win1234.site4now.net:8172/msdeploy.axd?site=abfa09-001-site1
    DeployIisAppPath    e.g. abfa09-001-site1
    UserName            e.g. abfa09-001
  The password is NOT stored here: Visual Studio asks for it on the first publish and keeps it
  encrypted in SmarterASP.pubxml.user, which git ignores.

  Publish: right-click MinnieWorld.Web → Publish → SmarterASP → Publish.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish>https://minnieworld.com</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <ProjectGuid>220985E7-2660-4DD5-9F90-0CB5ECF1F443</ProjectGuid>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Self-contained: the .NET 10 runtime ships with the site, so it runs even if the server only has older .NET installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <MSDeployServiceURL>https://YOUR-SERVER.site4now.net:8172/msdeploy.axd?site=YOUR-SITE-NAME</MSDeployServiceURL>
    <DeployIisAppPath>YOUR-SITE-NAME</DeployIisAppPath>
    <UserName>YOUR-WEBDEPLOY-USERNAME</UserName>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <AllowUntrustedCertificate>true</AllowUntrustedCertificate>
    <_SavePWD>true</_SavePWD>

    <!-- Takes the site offline (app_offline.htm) while files are copied, so locked DLLs don't fail the publish. -->
    <EnableMsDeployAppOffline>true</EnableMsDeployAppOffline>
    <!-- Never upload local App_Data, and never delete files on the server: admin image uploads live in App_Data/uploads there. -->
    <ExcludeApp_Data>true</ExcludeApp_Data>
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
  </PropertyGroup>
</Project>
